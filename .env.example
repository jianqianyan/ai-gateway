NODE_ENV=development
PORT=3000
APP_NAME=AI Gateway
APP_TIMEZONE=Asia/Shanghai

# MySQL (inside docker compose use host "mysql"; host dev uses localhost:3307)
DATABASE_URL=mysql://ai_gateway:ai_gateway_password@mysql:3306/ai_gateway
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=ai_gateway
MYSQL_USER=ai_gateway
MYSQL_PASSWORD=ai_gateway_password

REDIS_URL=redis://redis:6379

# 32-byte base64 AES key
ENCRYPTION_KEY=srARXORjUkHhSlJQa71cG4t4Wms9IuSDzk8YD1d6cEg=
JWT_SECRET=0bbdez+dFGrnUFManHguc75swnnP5Vsmq+mNeiVeVntk8R14rJIheV1th/raOFlW
JWT_ACCESS_TTL=900s
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
SEED_RESET_PASSWORDS=false

# Seed accounts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=Viewer@123456

# Security / proxy
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=1
RATE_LIMIT_FAIL_OPEN=true
MAX_BODY_BYTES=10485760
UPSTREAM_TIMEOUT_MS=120000
ALLOW_PRIVATE_UPSTREAMS=true

# Log retention
LOG_RETENTION_DAYS=30
BODY_RETENTION_DAYS=7
