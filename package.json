{
  "name": "ai-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:api": "pnpm --filter @ai-gateway/api start:dev",
    "dev:web": "pnpm --filter @ai-gateway/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @ai-gateway/api test",
    "test:api": "node scripts/regression-api.mjs",
    "test:ui": "node scripts/regression-ui.mjs",
    "test:ui:smoke": "node scripts/ui-smoke.mjs",
    "test:regression": "node scripts/regression.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:test": "docker compose --profile test up -d --build",
    "docker:down": "docker compose --profile test down",
    "docker:logs": "docker compose logs -f --tail=200"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
